{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "src/app/types.ts",
    "src/data/cards.ts",
    "src/game/engine.ts",
    "src/game/ai.ts",
    "src/game/goals.ts",
    "src/game/levels.ts",
    "src/game/rating.ts",
    "src/game/rankedReplay.ts",
    "src/game/session.ts",
    "src/game/sessionConfig.ts",
    "src/game/trends.ts",
    "src/game/types.ts",
    "src/i18n.ts"
  ]
}
