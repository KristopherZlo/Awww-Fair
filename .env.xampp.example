# Copy to .env.xampp for local XAMPP overrides.
# The real .env.xampp file is ignored by Git.

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=trend_market

# Apache is the LAN-facing server. Node listens locally and receives /api via proxy.
HOST=127.0.0.1
PORT=5176
PUBLIC_PORT=80
PUBLIC_PATH=trendmarket

# Keep this enabled only on a trusted local network.
AUTH_DEV_LOGIN=true
DEV_MEMORY_STORE=false

# Optional for OAuth providers. Use the LAN origin without /trendmarket because callbacks live under /api.
# APP_BASE_URL=http://192.168.1.24
# PUBLIC_URL=http://192.168.1.24/trendmarket
